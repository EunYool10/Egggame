rules_version = '2';

// 계란이의 모험 v3 — Firestore 보안 규칙 (Firebase 프로젝트 egggame-eunyool, (default) 데이터베이스, 서울 리전)
// 배포: firebase deploy --only firestore:rules (firebase.json, .firebaserc 참고)
// 엔딩·장면을 추가하면 아래 endingIds / sceneIds 목록도 함께 고쳐야 저장된다. (스킨은 id 모양만 확인하므로 고칠 필요 없음)
//
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: players
// Document ID: the player's Firebase Auth uid (Google sign-in)
// Fields:
//   - book: map (required) - the player's ending book
//       - endings: map<endingId, int> (required, known ending ids only) - times each ending was seen
//         (counts are clamped to 1..100000 by the game when read, see isValidEndings)
//       - scenes: list<string> (required, <= 60 items, known scene ids only) - scenes visited at least once
//       - stats: map (required, all five keys)
//           - plays, finished, crashes, choices: int (0..10,000,000)
//           - bestTrue: int (1..1000) or null - fewest choices to the true ending
//   - skin: string (optional, 1-32 lowercase letters, digits or hyphens) - the egg skin being worn
//   - run: string (optional, <= 40,000 chars) or null - JSON of the in-progress adventure (이어하기)
//   - updatedAt: timestamp (required, must equal request.time) - last sync time
//
// No PII is stored: the display name and email come from the auth token on the client only.
// The app only reads and writes its own document by id (no list queries).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The document never carries a uid field (the document id is the uid); these keep it that way.
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function endingIds() {
      return ['e_hatch', 'e_twins', 'e_party', 'e_crayfish', 'e_helmet', 'e_late', 'e_school', 'e_easter',
        'e_treasure', 'e_seoul', 'e_lucky', 'e_vlog', 'e_factory', 'e_jangjorim', 'e_omelet', 'e_baked',
        'e_tteok', 'e_forest', 'e_sunfry', 'e_again', 'e_chicken', 'e_crash', 'e_g_hatch', 'e_g_party',
        'e_g_king', 'e_g_museum', 'e_g_alji', 'e_g_crack', 'e_g_late', 'e_g_dragon', 'e_g_ayuta', 'e_g_song',
        'e_g_baked', 'e_g_tiger', 'e_g_fox', 'e_g_crash', 'e_f_hatch', 'e_f_party', 'e_f_alien', 'e_f_helmet',
        'e_f_late', 'e_f_robot', 'e_f_moon', 'e_f_saturn', 'e_f_omelet', 'e_f_engine', 'e_f_salad',
        'e_f_trash', 'e_f_crash'];
    }

    function sceneIds() {
      return ['start', 'elder', 'swap', 'kitchen', 'living', 'ondol', 'cat', 'basket', 'roof', 'market',
        'truck', 'yard', 'dog', 'alley', 'm_bath', 'm_attic', 'm_playground', 'm_bakery', 'farm', 'stream',
        'field', 'storm', 'collect', 'hatchery', 'g_start', 'g_box', 'g_pine', 'g_kiln', 'g_smithy',
        'g_market', 'g_well', 'g_port', 'g_river', 'g_pass', 'g_bamboo', 'g_cave', 'g_gyerim', 'g_frost',
        'f_start', 'f_corridor', 'f_engine', 'f_garden', 'f_lab', 'f_gym', 'f_galley', 'f_medbay', 'f_window',
        'f_pod', 'f_mars', 'f_dust'];
    }

    // Skin ids are only checked for shape (lowercase letters, digits and hyphens, up to 32 chars).
    // The skin is cosmetic and the game ignores an id it does not know, so new skins need no rules change.
    function isValidSkin(s) {
      return s is string && s.matches('^[a-z0-9-]{1,32}$');
    }

    // Only the ending ids are checked. Checking all 48 counts one by one passes the
    // 1000-expressions-per-request limit, and a bad count can only be in the player's own save:
    // the game clamps every count to 1..100000 when it reads the save (js/account.js fromCloud).
    function isValidEndings(m) {
      return m is map && m.keys().hasOnly(endingIds());
    }

    function isValidScenes(l) {
      return l is list && l.size() <= 60 && l.hasOnly(sceneIds());
    }

    function isStat(m, k) {
      return m[k] is int && m[k] >= 0 && m[k] <= 10000000;
    }

    function isValidStats(m) {
      return m is map &&
        m.keys().hasOnly(['plays', 'finished', 'crashes', 'choices', 'bestTrue']) &&
        m.keys().hasAll(['plays', 'finished', 'crashes', 'choices', 'bestTrue']) &&
        isStat(m, 'plays') && isStat(m, 'finished') && isStat(m, 'crashes') && isStat(m, 'choices') &&
        (m.bestTrue == null || (m.bestTrue is int && m.bestTrue >= 1 && m.bestTrue <= 1000));
    }

    function isValidBook(b) {
      return b is map &&
        b.keys().hasOnly(['endings', 'scenes', 'stats']) &&
        b.keys().hasAll(['endings', 'scenes', 'stats']) &&
        isValidEndings(b.endings) && isValidScenes(b.scenes) && isValidStats(b.stats);
    }

    // ===============================================================
    // Domain Validator (used on BOTH create and update)
    // ===============================================================
    function isValidPlayer(data) {
      return hasOnlyAllowedFields(['book', 'skin', 'run', 'updatedAt']) &&
        hasRequiredFields(['book', 'updatedAt']) &&
        isValidBook(data.book) &&
        (!('skin' in data) || isValidSkin(data.skin)) &&
        (!('run' in data) || data.run == null || (data.run is string && data.run.size() <= 40000)) &&
        data.updatedAt == request.time &&
        uidUnchanged();
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Each player reads and writes only their own save. Nobody can list the collection.
    match /players/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidPlayer(request.resource.data);
      allow update: if isOwner(userId) && isValidPlayer(request.resource.data) && uidNotModified();
      allow delete: if isOwner(userId);
    }

    // Everything else is denied by default.
  }
}
